# 复制为 SANDBOX.env 后填写真实值。SANDBOX.env 已被 .gitignore 忽略，请勿提交。

# Runtime
RUNTIME_BIND_HOST=<runtime-bind-host, e.g. 0.0.0.0>
RUNTIME_PORT=<runtime-port>
RUNTIME_PUBLIC_HOST=<runtime-public-host-or-ip>
EXECD_PORT=<execd-port>

# Manager
MANAGER_BIND_HOST=<manager-bind-host, e.g. 0.0.0.0>
MANAGER_PORT=<manager-port>
MANAGER_RUNTIME_URL=http://<runtime-public-host-or-ip>:<runtime-port>
